              Thêm Khách Hàng
            </Button>
          )}
        </div>
      </div>

      {/* Filters */}
      <CustomerFilterBar
        filters={filters}
        onFilterChange={setFilters}
        onApply={handleApplyFilters}
        onReset={handleResetFilters}
