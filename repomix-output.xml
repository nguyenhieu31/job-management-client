  const filteredCustomers = useMemo(() => {
    if (!customers) return [];

    return customers.data.filter((customer) => {
      // Search filter (search in name, email, phone)
      if (appliedFilters.search) {
        const searchLower = appliedFilters.search.toLowerCase();
        const matchName = customer.name.toLowerCase().includes(searchLower);
        const matchEmail = customer.email.toLowerCase().includes(searchLower);
        const matchPhone = customer.phone.toLowerCase().includes(searchLower);

        if (!matchName && !matchEmail && !matchPhone) {
          return false;
        }
      }

      return true;
    });
  }, [customers, appliedFilters]);

  // Handle filter actions
  const handleApplyFilters = () => {
    setAppliedFilters(filters);
    setPagination((prev) => ({ ...prev, currentPage: 1 }));
