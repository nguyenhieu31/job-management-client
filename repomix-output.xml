<file path="src/app/dashboard/work-requests/page.tsx">
"use client";

import { useState, useMemo, useEffect, useCallback } from "react";
import { Button } from "@/components/ui/button";
import { Plus } from "lucide-react";
import { WorkRequestForm } from "@/components/work-requests/work-request-form";
import { WorkRequestTable } from "@/components/work-requests/work-request-table";
import { WorkRequestFilterBar } from "@/components/work-requests/work-request-filter-bar";
import { Pagination } from "@/components/jobs/pagination";
import type {
  WorkRequestResponse,
  WorkRequestFilters,
  WorkRequestPagination,
} from "@/types/work-requests";
import { useAppDispatch, useAppSelector } from "@/store/store";
import { toast } from "react-toastify";
import Loader from "@/components/ui/loader";
import { CreateWorkRequestAction, GetAllWorkRequestsAction } from "@/store/slice/work-request/WorkRequest";
import { PageResponse } from "@/components/types/Page";

export default function WorkRequestsPage() {
  const dispatch = useAppDispatch();
  // const [workRequests, setWorkRequests] =
  //   useState<WorkRequestResponse[]>(initialWorkRequests);
  const [formOpen, setFormOpen] = useState(false);
  const [editingWorkRequest, setEditingWorkRequest] =
    useState<WorkRequestResponse | null>(null);
  const [loading] = useState(false);

  // Filters state
  const [filters, setFilters] = useState<WorkRequestFilters>({
    search: "",
  });

  // Applied filters (used for actual filtering)
  const [appliedFilters, setAppliedFilters] =
    useState<WorkRequestFilters>(filters);

  // Pagination state
  const [pagination, setPagination] = useState<WorkRequestPagination>({
    currentPage: 1,
    pageSize: 10,
    totalItems: 0,
    totalPages: 0,
  });

  // Get data from Redux store
  const { roleName } = useAppSelector((state) => state.authenticate);
  const { workRequests } : { workRequests: PageResponse<WorkRequestResponse[]> } = useAppSelector((state) => state.workRequest);

  // Filter work requests
  const filteredWorkRequests = useMemo(() => {
    const filtered = workRequests ? workRequests.data.filter((workRequest) => {
      // Search filter (search in category name or file type)
      if (appliedFilters.search) {
        const searchLower = appliedFilters.search.toLowerCase();
        const matchCategory = workRequest.categoryName
          .toLowerCase()
          .includes(searchLower);
        const matchFileType = workRequest.fileType
          .toLowerCase()
          .includes(searchLower);

        if (!matchCategory && !matchFileType) {
          return false;
        }
      }

      return true;
    }) : [];

    // Update total items
    setPagination((prev) => ({
      ...prev,
      totalItems: filtered.length,
      totalPages: Math.ceil(filtered.length / prev.pageSize),
    }));

    return filtered;
  }, [workRequests, appliedFilters]);

  // Paginate work requests
  const paginatedWorkRequests = useMemo(() => {
    const startIndex = (pagination.currentPage - 1) * pagination.pageSize;
    const endIndex = startIndex + pagination.pageSize;
    return filteredWorkRequests.slice(startIndex, endIndex);
  }, [filteredWorkRequests, pagination.currentPage, pagination.pageSize]);

  // Handle filter actions
  const handleApplyFilters = () => {
    setAppliedFilters(filters);
    setPagination((prev) => ({ ...prev, currentPage: 1 }));
  };

  const handleResetFilters = () => {
    const resetFilters: WorkRequestFilters = {
      search: "",
    };
    setFilters(resetFilters);
    setAppliedFilters(resetFilters);
    setPagination((prev) => ({ ...prev, currentPage: 1 }));
  };

  // Handle pagination actions
  const handlePageChange = (page: number) => {
    setPagination((prev) => ({ ...prev, currentPage: page }));
  };

  const handlePageSizeChange = (pageSize: number) => {
    setPagination((prev) => ({
      ...prev,
      pageSize,
      currentPage: 1,
    }));
  };

  const handleAddWorkRequest = async (
    workRequest: Partial<WorkRequestResponse>
  ) => {
    if (workRequest.id) {
      toast.success("Work request updated successfully");
      setEditingWorkRequest(null);
    } else {
      // Create new work request
      const data = {
        categoryName: workRequest.categoryName || "",
        summaryNote: workRequest.summaryNote || "",
        detailedNotes: workRequest.detailedNotes || "",
        linkSample: workRequest.linkSample || "",
        fileType: workRequest.fileType || "",
        colorNote: workRequest.colorNote || "",
      };
      await dispatch(CreateWorkRequestAction(data));
    }
  };

  const handleEditWorkRequest = (workRequest: WorkRequestResponse) => {
    setEditingWorkRequest(workRequest);
    setFormOpen(true);
  };

  const handleDeleteWorkRequest = (id: number) => {
    // setWorkRequests(workRequests.filter((wr) => wr.id !== id));
    toast.success("Work request deleted successfully");
  };

  const handleFormClose = (open: boolean) => {
    setFormOpen(open);
    if (!open) {
      setEditingWorkRequest(null);
    }
  };

  const fetchWorkRequests = useCallback(() => {
    if(!roleName) return;
    dispatch(GetAllWorkRequestsAction({
      pageNumber: pagination.currentPage - 1,
      pageSize: pagination.pageSize,
    }));
  }, [dispatch, pagination.currentPage, pagination.pageSize, roleName]);

  useEffect(() => {
    fetchWorkRequests();
  }, [fetchWorkRequests]);

  return (
    <div className="flex flex-col gap-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">
            Quản Lý Yêu Cầu Công Việc
          </h1>
          <p className="text-muted-foreground mt-1">
            Quản lý các loại yêu cầu, hướng dẫn và liên kết mẫu
          </p>
        </div>

        <div>
          {roleName === "MANAGER" && (
            <Button
              onClick={() => setFormOpen(true)}
              className="sm:w-auto cursor-pointer"
            >
              <Plus className="mr-2 h-4 w-4" />
              Thêm Yêu Cầu
            </Button>
          )}
        </div>
      </div>

      {/* Filters */}
      <WorkRequestFilterBar
        filters={filters}
        onFilterChange={setFilters}
        onApply={handleApplyFilters}
        onReset={handleResetFilters}
      />

      {/* Table */}
      {loading ? (
        <div className="flex justify-center items-center h-40">
          <Loader width={50} height={50} />
        </div>
      ) : (
        <>
          <WorkRequestTable
            workRequests={paginatedWorkRequests}
            onEdit={handleEditWorkRequest}
            onDelete={handleDeleteWorkRequest}
          />

          {/* Pagination */}
          <Pagination
            pagination={pagination}
            totalElements={workRequests.totalElements}
            totalPages={workRequests.totalPages}
            onPageChange={handlePageChange}
            onPageSizeChange={handlePageSizeChange}
          />
        </>
      )}

      {/* Form Dialog */}
      <WorkRequestForm
        open={formOpen}
        onOpenChange={handleFormClose}
        onSubmit={handleAddWorkRequest}
        editingWorkRequest={editingWorkRequest}
      />
    </div>
  );
}
</file>

