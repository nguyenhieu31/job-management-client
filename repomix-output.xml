      pageSize,
      currentPage: 1,
    }));
  };

  const handleAddCustomer = (customer: Partial<CustomerResponse>) => {
    if (customer.id) {
      // Update existing customer
      // TODO: Call API to update customer
      console.log("Updating customer:", customer);
      toast.success("Customer updated successfully");
      setEditingCustomer(null);
    } else {
      // Create new customer
      // TODO: Call API to create customer
      console.log("Creating customer:", customer);
      toast.success("Customer created successfully");
    }
    
    // Refresh the customer list
    fetchCustomers();
  };

  const handleEditCustomer = (customer: CustomerResponse) => {
    setEditingCustomer(customer);
    setFormOpen(true);
  };

  const handleDeleteCustomer = (id: number) => {
    // TODO: Call API to delete customer
    console.log("Deleting customer:", id);
    toast.success("Customer deleted successfully");
    
    // Refresh the customer list
    fetchCustomers();
