            onPageSizeChange={handlePageSizeChange}
          />
        </>
      )}

      {/* Form Dialog */}
      <CustomerForm
        open={formOpen}
        onOpenChange={handleFormClose}
        onSubmit={handleAddCustomer}
        editingCustomer={editingCustomer}
      />
    </div>
  );
}
