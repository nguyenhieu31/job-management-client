          Job,
          "id" | "code" | "date" | "totalPrice" | "outputCount" | "linkDone"
        >
      | Job
  ) => {
    if ("id" in newJob) {
      // Update existing job
      // setJobs(jobs.map((job) => (job.id === newJob.id ? newJob : job)));
      setEditingJob(null);
    } else {
      // Create new job
      const id = Math.max(0, ...initialJobs.map((j) => j.id)) + 1;
      const now = new Date();
      const date = now.toISOString().split("T")[0]; // YYYY-MM-DD format
      const code = `JOB-${String(id).padStart(3, "0")}`;

      const completeJob: Job = {
        ...newJob,
        id,
        code,
        date,
        totalPrice: newJob.inputCount * newJob.filePrice,
        outputCount: 0,
        linkDone: "",
      };

      // setJobs([...jobs, completeJob]);
    }
  };

