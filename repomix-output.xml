        </div>

        <div>
          {userRole === "manager" && (
            <Button
              onClick={() => setFormOpen(true)}
              className="sm:w-auto mr-2 cursor-pointer"
            >
              <Plus className="mr-2 h-4 w-4" />
              Thêm Công Việc
            </Button>
          )}
          <Button
            onClick={handleClickGetJob}
            className="sm:w-auto bg-green-600 hover:bg-green-700 cursor-pointer"
          >
            <ArrowDown className="mr-2 h-4 w-4" />
            {userRole !== 'manager' ? 'Nhận Công Việc' : 'Lấy Công Việc'}
          </Button>
        </div>
      </div>

      {/* Filters */}
      <FilterBar
        pagination={pagination}
        onPageChange={handlePageChange}
      />

      {/* Table */}
      {loading ? (
        <div className="flex justify-center items-center h-40">
          <Loader width={50} height={50} />
        </div>
      ) : (
        <>
          <JobTable
            jobs={jobs ? jobs.data : []}
            userRole={userRole}
            employees={employees?.data.filter((e) => e.role.name.toLowerCase() === "employee") || []}
            qaList={employees?.data.filter((e) => e.role.name.toLowerCase() === "qa") || []}
            customers={customers?.data || []}
            onEdit={handleEditJob}
            onDelete={handleDeleteJob}
            onJobAction={handleJobAction}
          />

          {/* Pagination */}
          <Pagination
            pagination={pagination}
            totalElements={jobs?.totalElements || 0}
            totalPages={jobs?.totalPages || 0}
            onPageChange={handlePageChange}
            onPageSizeChange={handlePageSizeChange}
          />
        </>
      )}

      {/* Form Dialog */}
      <JobForm
        open={formOpen}
        onOpenChange={handleFormClose}
        onSubmit={handleAddJob}
        editingJob={editingJob}
        customers={customersList}
        employees={employeesList}
        workRequests={workRequests?.data || []}
      />
    </div>
  );
}
